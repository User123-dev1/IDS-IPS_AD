    def log(self, message: str) -> None:
        """Safe logger"""
        ts = datetime.now().strftime("%H:%M:%S")
        lt = getattr(self, "logs_text", None)
        try:
            if lt is not None:
                lt.append(f"[{ts}] {message}")
                cursor = lt.textCursor()
                cursor.movePosition(cursor.MoveOperation.End)
                lt.setTextCursor(cursor)
            else:
                print(f"[{ts}] {message}")
        except Exception:
            print(f"[{ts}] {message}")

